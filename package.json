{
  "name": "rook",
  "productName": "Rook",
  "version": "0.5.0",
  "description": "Note-taking agent: Claude Code (WSL) with write access only to the Obsidian vault",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --x64",
    "release:win": "bash scripts/release.sh",
    "test": "node --test test/"
  },
  "devDependencies": {
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "rcedit": "^5.0.2"
  },
  "build": {
    "appId": "com.alialialjasim.rook",
    "productName": "Rook",
    "files": [
      "src/**/*",
      "package.json",
      "build/icon.ico",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "executableName": "rook",
      "signAndEditExecutable": false
    },
    "afterPack": "scripts/after-pack.js",
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Rook",
      "uninstallDisplayName": "Rook",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "rook-setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "AliAliAljasim",
        "repo": "rook",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "author": "AliAliAljasim"
}
